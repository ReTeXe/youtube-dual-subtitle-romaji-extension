{
  "manifest_version": 3,
  "name": "YouTube Romaji + Türkçe Altyazı",
  "version": "3.1",
  "description": "YouTube Japonca altyazıları Romaji ve ikinci dil olarak gösterir.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Romaji & Subtitle"
  }
}
